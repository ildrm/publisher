{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/manuscript-ast.v2.schema.json",
  "title": "Canonical manuscript chapter v2",
  "description": "Runtime canonical restricted semantic tree. Python domain validation additionally enforces nesting, unique UUID block IDs, combined depth/node/text/byte budgets, marks and link behavior.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$"
    },
    "direction": {
      "enum": [
        "auto",
        "ltr",
        "rtl"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "required": [
        "type",
        "content"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "language",
    "direction",
    "content"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "blockquote",
            "bulletList",
            "orderedList",
            "listItem",
            "horizontalRule",
            "text",
            "hardBreak"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": []
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "content": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "marks": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "code",
                  "link"
                ]
              },
              "attrs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "href": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^(https?://|mailto:)"
                  },
                  "target": {
                    "enum": [
                      null,
                      "_blank",
                      "_self"
                    ]
                  },
                  "rel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "class": {
                    "type": "null"
                  }
                },
                "required": []
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "paragraph",
                  "heading",
                  "blockquote",
                  "bulletList",
                  "orderedList",
                  "listItem",
                  "horizontalRule"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "attrs"
            ],
            "properties": {
              "attrs": {
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        }
      ]
    }
  }
}
