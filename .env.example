# Export desired values in your shell; this file is a reference, not automatically loaded.
PUBLISHER_ENV=local
PORT=8000
PUBLISHER_ORIGIN=http://127.0.0.1:8000
# Optional absolute directory for private local data; defaults to .data/.
# PUBLISHER_DATA_DIR=/private/tmp/publisher-local
# Optional seed-only synthetic password. Never reuse an actual account password.
# PUBLISHER_SEED_PASSWORD=
